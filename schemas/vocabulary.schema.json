{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w3id.org/os-glossary/schema/vocabulary.schema.json",
  "title": "Open Science Glossary data vocabularies (data/*.yaml)",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string" },
          "inverse_label": { "type": "string" },
          "skos": { "type": "string" },
          "description": { "type": "string" },
          "notice": { "type": "string" },
          "reviewed_rule": { "type": "string" }
        }
      }
    }
  }
}
